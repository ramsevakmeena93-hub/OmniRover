{
  "version": 2,
  "builds": [
    {
      "src": "rescue-rover/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npm ci && npx vite build"
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
